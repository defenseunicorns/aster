; Aster Mesh Protocol 1.0 — deterministic-CBOR replication grammar
; Source envelopes, custody wrappers, handshakes, Blob manifests, and Blob
; chunk carriers use the separately specified bounded binary security profile
; in envelope.md. This CDDL defines only deterministic-CBOR messages.
; Semantic-v2/v3/v4/v5/v6/v7/v8/v9 ASTRENV3 batch proof/item bytes are the same fixed binary
; profile in protocol.md section 6.1 and MUST NOT be decoded or normalized as
; CBOR. Semantic versions 3 through 9 additionally carry semantic-v3-format custody
; in a distinct fixed binary session-record domain; they do not allocate another
; deterministic-CBOR kind.
; A receiver on semantic version 1 MUST reject raw input beginning "ASTRENV3"
; before fixed-envelope dispatch. Its deterministic-CBOR receive path MUST also
; reject an otherwise canonical message containing an object-id whose first
; byte is 3, 4, or 5; this is a receive rule, not merely an encoder restriction.
; In protocol maps, unknown keys 0..63 are critical and cause rejection.
; Unknown keys 64 and above are optional and ignored by version-1 readers after
; their deterministically encoded value is bounded and skipped.
; Extension values use the same deterministic subset as the reference Value
; decoder: unsigned and negative integers, byte/text strings, booleans, null,
; arrays, and maps with unsigned keys. Tags, floats, other simple values, and
; indefinite lengths are outside the profile.
; Default reader bounds are one MiB per message and byte string, 4096 bytes per
; text string, 4096 entries per collection, and 16 levels of nesting.

extension-value = uint / nint / bytes / tstr / bool / null /
                  [* extension-value] / {* uint => extension-value}

; object-id is exactly kind:u8 || digest:bytes .size 32.
; Semantic version 1 permits 1=stable source envelope and 2=Blob chunk carrier.
; Semantic versions 2 through 9 additionally permit 3=source-batch proof,
; 4=bridge authorization, and 5=bridge-route wrapper. A semantic-v1 reader
; suppresses those extended kinds before inventory construction and rejects
; them in every received Offer, Want, Data, and Receipt. Collections sort the
; complete 33 bytes. The byte-string size rule below is necessary but not
; sufficient: the selected semantic-version decoder validates byte 0.
semantic-v1-object-kind = 1 / 2
semantic-v2-object-kind = semantic-v1-object-kind / 3 / 4 / 5
semantic-v3-object-kind = semantic-v2-object-kind
semantic-v4-object-kind = semantic-v3-object-kind
semantic-v5-object-kind = semantic-v4-object-kind
semantic-v6-object-kind = semantic-v5-object-kind
semantic-v7-object-kind = semantic-v6-object-kind
semantic-v8-object-kind = semantic-v7-object-kind
semantic-v9-object-kind = 1 / 3 / 4 / 5
object-id = bytes .size 33
hash-256 = bytes .size 32
priority = 0..3

; Sync maps share 0=protocol version, 1=message kind, and 2=exchange id.
; Topic/scope and identifier collections are strictly increasing and unique.
interest = {
  0: 1,
  1: 1,
  2: uint,
  3: [* tstr],                ; subscribed/carry topic names
  4: [* tstr],                ; joined scope names
  5: priority,                ; minimum offered priority
  6: 1..4294967295,           ; maximum offered identifiers
  * (64..18446744073709551615) => extension-value,
}

summary = {
  0: 1, 1: 2, 2: uint,
  3: hash-256,                ; inventory root
  4: uint,                    ; item count
  5: uint,                    ; snapshot correlation id
  * (64..18446744073709551615) => extension-value,
}

probe = {
  0: 1, 1: 3, 2: uint,
  3: bytes,                   ; packed big-endian nibbles
  4: 0..66,                   ; significant nibbles of the 33-byte ObjectID
  5: uint,                    ; snapshot correlation id
  * (64..18446744073709551615) => extension-value,
}

child-summary = {
  0: 0..15, 1: hash-256, 2: uint .gt 0,
  * (64..18446744073709551615) => extension-value,
}
radix-node = {
  0: 1, 1: 4, 2: uint,
  3: bytes,                   ; packed prefix
  4: 0..66,
  5: hash-256,
  6: uint,                    ; equals summed child counts below depth 66;
                              ; a depth-66 leaf has count 0 or 1
  7: [* child-summary],       ; ordered by nibble
                              ; at most 16; empty at depth 66
  8: uint,
  * (64..18446744073709551615) => extension-value,
}

offer = {
  0: 1, 1: 5, 2: uint,
  3: [* object-id],
  4: uint,
  * (64..18446744073709551615) => extension-value,
}

range = [uint, uint]          ; start inclusive, end exclusive
                              ; lists are sorted, disjoint, and coalesced;
                              ; overlap and adjacency are rejected
want-entry = {
  0: object-id,
  1: uint / null,             ; null until total length is learned
  2: [* range],               ; exact sorted/disjoint missing ranges
  3: bool,                    ; request forwarding metadata; allowed for kinds
                              ; 1, 3, and 5; MUST be false for kinds 2 and 4
  * (64..18446744073709551615) => extension-value,
}
; Initial Blob request: field 1 null, field 2 empty, field 3 false. Once its
; total is known, a Blob request has nonempty missing ranges; empty ranges plus
; false forwarding requests no work and is rejected.
want = {
  0: 1, 1: 6, 2: uint,
  3: [* want-entry],
  * (64..18446744073709551615) => extension-value,
}

data = {
  0: 1, 1: 7, 2: uint,
  3: object-id,
  4: uint,                    ; total length
  5: uint,                    ; chunk offset
  6: bytes,                   ; stable object range
  7: bytes,                   ; forwarding wrapper or empty; MUST be empty for
                              ; Blob chunk kind 2 and authorization kind 4
                              ; fields 6 and 7 MUST NOT both be empty
  * (64..18446744073709551615) => extension-value,
}

receipt = {
  0: 1, 1: 8, 2: uint,
  3: object-id,
  4: uint,
  5: [* range],               ; durably stored ranges
  6: bool,                    ; true exactly for total=0 or sole range [0,total]
  * (64..18446744073709551615) => extension-value,
}

sync-message = interest / summary / probe / radix-node / offer / want / data / receipt

; Semantic-v7 transfer-profile and Event-page mechanics are canonical fixed
; binary plaintexts inside protected ASTRFR01 records, not deterministic-CBOR
; replication messages. Their lane/profile/frame registries and exact field
; order are specified in protocol.md section 9.4 and locked by the executable
; conformance/vectors/event-pages-v7.tsv corpus. They allocate no ObjectKind and
; do not change any sync-message encoding above.
;
; Semantic-v9/profile-5 Blob streaming is canonical fixed binary, not CBOR, so
; an ordinary CDDL production would falsely describe its concatenated fields.
; conformance/profile5-wire-schema.json is the machine-checkable structured
; equivalent: it defines every tag, ordered field, width, enum, native ASTRBS02
; record bound, ASD1 composite prefix, and empty/nonempty flow. The standalone
; contract checker binds that schema to the Rust encoder/decoder and independent
; oracle/vectors. These aliases are only a CDDL index into that complete schema.
; stream-profile-v5 = stream-open-v1 / stream-source-v1 / stream-accept-v1 / stream-data-v1 / stream-checkpoint-v1 / stream-finish-v1 / stream-result-v1 / stream-result-ack-v1
; stream-data-v1 = "ASM\x01\xd8" attempt-tuple offset-u64 record-len-u32 astrbs02-record
; astrbs02-record = "ASTRBS02" authenticated-segment-header ciphertext-and-tag
; The complete canonical ASTRPS02 SOURCE is <= 401,902 bytes and therefore one
; SOURCE record is sufficient; every DATA body contains
; one complete ASTRBS02 record of at most 1,048,706 bytes plus its four-byte
; length prefix; checkpoint_batch_bytes
; is in 1..134,217,728. Exact empty content has no DATA/CHECKPOINT record and
; settles with FINISH(final_offset=0), RESULT, and ACK after authenticated OPEN,
; SOURCE, and ACCEPT.
