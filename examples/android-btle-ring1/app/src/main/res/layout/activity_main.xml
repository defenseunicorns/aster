<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/linux_address"
            android:inputType="textNoSuggestions"
            android:maxLength="17" />

        <EditText
            android:id="@+id/psm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/psm"
            android:inputType="number"
            android:maxLength="3" />

        <EditText
            android:id="@+id/missionPeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mission_peer"
            android:inputType="textNoSuggestions"
            android:maxLength="64" />

        <Button
            android:id="@+id/selectMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_mission" />

        <TextView
            android:id="@+id/missionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mission_missing" />

        <EditText
            android:id="@+id/eventText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1024"
            android:maxLines="4" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_validate" />

        <Button
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="ready"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
