+}
+thread_local! {
+    static VOLUME_DIAGNOSTIC: std::cell::RefCell<Option<VolumeDiagnostic>> = const { std::cell::RefCell::new(None) };
+}
+struct VolumeDiagnosticGuard;
+impl VolumeDiagnosticGuard {
+    fn start() -> Self {
+        VOLUME_DIAGNOSTIC.with(|cell| {
+            *cell.borrow_mut() = Some(VolumeDiagnostic {
+                started: Instant::now(), sampled_ms: 0, loop_started_ms: 0,
+                durable_sampled_ms: 0, phase: "prepare", counters: [0; 22],
+                durable: [0; 4], costs: [[0; 3]; 5], emitted: 0,
+            });
+        });
+        Self
+    }
+}
+impl Drop for VolumeDiagnosticGuard {
+    fn drop(&mut self) {
+        volume_diag_emit("final");
+        VOLUME_DIAGNOSTIC.with(|cell| { *cell.borrow_mut() = None; });
+    }
+}
+fn volume_diag_phase(phase: &'static str) {
+    VOLUME_DIAGNOSTIC.with(|cell| {
+        if let Some(d) = cell.borrow_mut().as_mut() { d.phase = phase; }
+    });
+    volume_diag_emit("phase");
+}
+struct VolumeDiagnosticSpan(usize, Instant);
+impl Drop for VolumeDiagnosticSpan {
+    fn drop(&mut self) {
+        let elapsed = self.1.elapsed().as_nanos();
+        VOLUME_DIAGNOSTIC.with(|cell| {
+            if let Some(d) = cell.borrow_mut().as_mut() {
+                d.costs[self.0][0] += 1;
+                d.costs[self.0][1] += elapsed;
+                d.costs[self.0][2] = d.costs[self.0][2].max(elapsed);
+            }
+        });
+    }
+}
+fn volume_diag_boundaries(a: &ChannelBridge, c: &ChannelBridge, ao: &ProviderObservations, co: &ProviderObservations) {
+    VOLUME_DIAGNOSTIC.with(|cell| {
+        if let Some(d) = cell.borrow_mut().as_mut() {
+            d.sampled_ms = d.started.elapsed().as_millis();
+            d.counters = [
+                a.accepted_sends(), ao.frames_submitted, ao.frames_sent,
+                co.frames_received, c.runtime_receives(),
+                c.accepted_sends(), co.frames_submitted, co.frames_sent,
+                ao.frames_received, a.runtime_receives(),
+                a.queued_to_provider.load(Ordering::Relaxed),
