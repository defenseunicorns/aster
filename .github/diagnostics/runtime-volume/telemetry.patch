+                u64::from(matches!(co.expected_direction, StreamDirection::Outbound)),
+            ];
+        }
+    });
+}
+fn volume_diag_durable(states: [u8; 4]) {
+    VOLUME_DIAGNOSTIC.with(|cell| {
+        if let Some(d) = cell.borrow_mut().as_mut() {
+            d.durable = states;
+            d.durable_sampled_ms = d.started.elapsed().as_millis();
+        }
+    });
+}
+// 0=not sampled; 1=absent; 2=present; 3=query error. No error text or early propagation.
+fn volume_diag_item<E>(result: Result<bool, E>) -> u8 {
+    match result { Ok(false) => 1, Ok(true) => 2, Err(_) => 3 }
+}
+fn volume_diag_emit(kind: &str) {
+    VOLUME_DIAGNOSTIC.with(|cell| {
+        if let Some(d) = cell.borrow_mut().as_mut() {
+            if d.emitted >= 64 && kind != "final" { return; }
