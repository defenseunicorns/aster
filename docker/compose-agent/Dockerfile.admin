ARG ASTER_RUST_BASE_IMAGE=rust@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97

FROM ${ASTER_RUST_BASE_IMAGE} AS build
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
COPY third-party ./third-party
COPY LICENSE THIRD_PARTY_NOTICES.md ./
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN --mount=type=secret,id=aster_build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=true \
    target="$(rustc -vV | sed -n 's/^host: //p')" \
    && cargo build --locked --release --target "$target" \
    -p aster-compose-credentials \
    --bin aster-compose-credential-admin \
    --bin aster-compose-verify \
    && install -d -m 0755 /out/rootfs/usr/local/bin /out/rootfs/usr/share/licenses/aster \
    && install -m 0555 "target/$target/release/aster-compose-credential-admin" \
        /out/rootfs/usr/local/bin/aster-compose-credential-admin \
    && install -m 0555 "target/$target/release/aster-compose-verify" \
        /out/rootfs/usr/local/bin/aster-compose-verify \
    && install -m 0444 LICENSE /out/rootfs/usr/share/licenses/aster/LICENSE \
    && install -m 0444 THIRD_PARTY_NOTICES.md \
        /out/rootfs/usr/share/licenses/aster/THIRD_PARTY_NOTICES.md

FROM scratch AS runtime
COPY --from=build /out/rootfs /
USER 10001:10001
