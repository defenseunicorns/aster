#!/usr/bin/python3 -I
# Copyright 2026 Defense Unicorns, Inc.
# SPDX-License-Identifier: Apache-2.0
"""Stopped-service install/rotate with an atomic, service-owned reference handoff."""
import argparse
import fcntl
import json
import os
import pwd
import re
import secrets
import stat
import subprocess
import sys

SERVICE = "aster-agent.service"
REFERENCE = "/etc/aster/agent-credentials/mission-reference"


def parse_result(operation, returncode, output):
    if returncode or len(output) > 17000:
        raise ValueError("administration failed")
    pattern = (operation.upper().encode() +
               rb" disposition=(?:installed|existing) generation=[1-9][0-9]{0,19} reference=([0-9a-f]{2,16384})\n")
    match = re.fullmatch(pattern, output)
    if not match or len(match[1]) % 2:
        raise ValueError("invalid administration result")
    return bytes.fromhex(match[1].decode("ascii"))


def secure_directory(path):
    """Pin each root-owned, non-writable ancestor without following symlinks."""
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.strip("/").split("/"):
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
            info = os.fstat(fd)
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
                raise ValueError("insecure directory")
        return fd
    except BaseException:
        os.close(fd)
        raise


def replace_file(directory, name, data, uid, gid, mode):
    try:
        info = os.stat(name, dir_fd=directory, follow_symlinks=False)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise ValueError("insecure destination")
    except FileNotFoundError:
        pass
    temporary = ".aster-handoff-" + secrets.token_hex(16)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fchown(stream.fileno(), uid, gid)
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate configuration field")
        result[key] = value
    return result


def load_configuration(directory):
    fd = os.open("agent.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) & 0o027 or info.st_size > 65536):
            raise ValueError("insecure configuration")
        raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError("oversized configuration")
    config = json.loads(raw, object_pairs_hook=unique_object)
    if config["credentials"]["mission_secret_ref_file"] != REFERENCE:
        raise ValueError("unexpected reference path")
    return config


def stop_service():
    subprocess.run(["/usr/bin/systemctl", "stop", SERVICE], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    state = subprocess.run(["/usr/bin/systemctl", "show", SERVICE,
                            "--property=ActiveState,SubState,MainPID,ControlPID"],
                           check=True, capture_output=True, text=True)
    values = dict(line.split("=", 1) for line in state.stdout.splitlines())
    if values != {"ActiveState": "inactive", "SubState": "dead", "MainPID": "0", "ControlPID": "0"}:
        raise ValueError("service has not stopped")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("install", "rotate"))
    parser.add_argument("--operation", required=True, dest="operation_id")
    parser.add_argument("--load-operation", required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise ValueError("root required")
    if not all(re.fullmatch(r"[0-9a-f]{64}", value) for value in (args.operation_id, args.load_operation)):
        raise ValueError("invalid operation identifier")
    account = pwd.getpwnam("aster")
    if not account.pw_uid:
        raise ValueError("invalid service user")
    os.umask(0o077)
    directory = secure_directory("/etc/aster")
    try:
        lock = os.open(".provision.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
                       0o600, dir_fd=directory)
        with os.fdopen(lock, "rb") as lockfile:
            info = os.fstat(lockfile.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                    or stat.S_IMODE(info.st_mode) != 0o600):
                raise ValueError("insecure lock")
            fcntl.flock(lockfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
            config = load_configuration(directory)
            handoff = secure_directory("/etc/aster/agent-credentials")
            try:
                stop_service()
                completed = subprocess.run([
                    "/usr/sbin/aster-credential-admin", args.operation,
                    "--operation", args.operation_id, "--load-operation", args.load_operation],
                    stdin=sys.stdin.buffer, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                reference = parse_result(args.operation, completed.returncode, completed.stdout)
                replace_file(handoff, "mission-reference", reference, account.pw_uid, account.pw_gid, 0o600)
                config["credentials"]["mission_load_id"] = args.load_operation
                replace_file(directory, "agent.json", (json.dumps(config, indent=2) + "\n").encode(),
                             0, account.pw_gid, 0o640)
            finally:
                os.close(handoff)
    finally:
        os.close(directory)
    print("Provisioning handoff complete; service remains stopped.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        print("Provisioning handoff failed. Keep the service stopped; reconcile or retry the same operation.",
              file=sys.stderr)
        sys.exit(1)
